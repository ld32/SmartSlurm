#!/bin/sh



echolog() { echo -e "$@\n"; echo $@ >>.smartSlurm.log; }

echolog1() { echo "$@" >> .smartSlurm.log; }

# T2: detect invisible "paste gremlin" bytes in a verbatim #@end block body and
# WARN loudly (never auto-fix). These bytes are kept byte-for-byte (by design) but
# almost always break on the compute node -- e.g. a trailing CR makes a redirect
# write to a mis-named file while the job still exits 0 (green-but-broken). The
# scan is byte-based (LC_ALL=C grep), so it needs no awk and behaves identically
# on mawk-only clusters. It only flags INVISIBLE artifacts, never legitimate
# visible non-ASCII (accented letters, CJK, emoji), which round-trip fine.
_ssGremlinWarn() {  # $1=step label  $2=human name  $3=raw bytes ; body in $_SS_GREM_BODY
    local lines
    lines=$(LC_ALL=C grep -nF -- "$3" <<<"$_SS_GREM_BODY" 2>/dev/null | cut -d: -f1 | paste -sd, -)
    [ -n "$lines" ] && echolog "Warning: #@ block '$1' body contains $2 (an invisible paste artifact) on block line(s) $lines. It is kept verbatim and will likely break on the compute node while the job still reports success. Re-type the affected line(s) or re-paste as plain ASCII."
}
_ssGremlinScan() {  # $1 = step label ; verbatim body on stdin
    local _SS_GREM_BODY; _SS_GREM_BODY="$(cat)"
    _ssGremlinWarn "$1" "a carriage return (CRLF / Windows line ending)"        $'\r'
    _ssGremlinWarn "$1" "a byte-order mark / zero-width no-break space (U+FEFF)" $'\xef\xbb\xbf'
    _ssGremlinWarn "$1" "a non-breaking space (U+00A0)"                          $'\xc2\xa0'
    _ssGremlinWarn "$1" "a narrow no-break space (U+202F)"                       $'\xe2\x80\xaf'
    _ssGremlinWarn "$1" "a zero-width space (U+200B)"                            $'\xe2\x80\x8b'
    _ssGremlinWarn "$1" "a zero-width non-joiner (U+200C)"                       $'\xe2\x80\x8c'
    _ssGremlinWarn "$1" "a zero-width joiner (U+200D)"                           $'\xe2\x80\x8d'
    _ssGremlinWarn "$1" "a word joiner (U+2060)"                                 $'\xe2\x81\xa0'
    _ssGremlinWarn "$1" "a thin space (U+2009)"                                  $'\xe2\x80\x89'
    _ssGremlinWarn "$1" "a hair space (U+200A)"                                  $'\xe2\x80\x8a'
    _ssGremlinWarn "$1" "an ideographic space (U+3000)"                          $'\xe3\x80\x80'
    _ssGremlinWarn "$1" "a Unicode line separator (U+2028)"                      $'\xe2\x80\xa8'
    _ssGremlinWarn "$1" "a Unicode paragraph separator (U+2029)"                 $'\xe2\x80\xa9'
}

output="Running: `realpath $0`"

for param in "$@"; do
    if [[ "$param" == *\ * ]]; then
        output="$output \"$param\""
    else
        output="$output $param"
    fi
done

usage() {
    echolog -e "Usage: \n${0##*/} --script \"bashScriptV2.sh [parameter1] [parameter2] ...\" --tmp useTmp|noTmp [--pipeline NAME] [--sbatch-options \"sbatch -p medium -t 24:0:0 -c 4\"] [--mode dryrun] [--lint] [--email emailPerSample|allJobs|successJobOnly|failedJobOnly|requeueOnly|noEmail] [--special checkpoint|excludeFailedNodes] [-v|--verbose | -q|--quiet]"
    echolog -e "Pipeline identity (keeps each pipeline's resource history separate): --pipeline NAME overrides a '#@pipeline NAME' directive in the script header, which overrides the script basename. Add '#@pipeline <name>' near the top of the script to give it a stable, unique id."
    exit 1
}

require_option_value() {
    [ -z "$2" ] && { echolog "Missing value for option: $1"; usage; }
    [[ "$2" == --* ]] && { echolog "Missing value for option: $1"; usage; }
}

PIPELINE_SPEC=""
SBATCH_OPTIONS=""
TMP_MODE=""
RUN_MODE=""
VERBOSITY="normal"
EMAIL_MODE=""
SPECIAL_MODE=""

thisCmd="$0 $@"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --script)
            require_option_value "$1" "$2"
            PIPELINE_SPEC="$2"
            shift 2
            ;;
        --pipeline)
            require_option_value "$1" "$2"
            PIPELINE_NAME="$2"
            shift 2
            ;;
        --sbatch-options)
            require_option_value "$1" "$2"
            SBATCH_OPTIONS="$2"
            shift 2
            ;;
        --tmp)
            require_option_value "$1" "$2"
            TMP_MODE="$2"
            shift 2
            ;;
        --mode)
            require_option_value "$1" "$2"
            RUN_MODE="$2"
            shift 2
            ;;
        --lint)
            LINT_MODE=yes
            RUN_MODE=dryrun
            shift
            ;;
        -v|--verbose)
            VERBOSITY=verbose
            shift
            ;;
        -q|--quiet)
            VERBOSITY=quiet
            shift
            ;;
        --email)
            require_option_value "$1" "$2"
            EMAIL_MODE="$2"
            shift 2
            ;;
        --special)
            require_option_value "$1" "$2"
            SPECIAL_MODE="$2"
            shift 2
            ;;
        -h|--help)
            usage
            ;;
        *)
            echolog "Unknown option: $1"
            usage
            ;;
    esac
done

[ -z "$PIPELINE_SPEC" ] && usage
[ -z "$TMP_MODE" ] && usage

PIPELINE_SCRIPT=${PIPELINE_SPEC%% *}
[ -f "$PIPELINE_SCRIPT" ] || { echolog bash script file does not exist: .${PIPELINE_SCRIPT}... Exiting...; usage; }

# v2 jobRecords: every step is tagged with a pipeline id so the same program in two
# different pipelines does not pool into one resource fit. Identity precedence:
#   1. --pipeline NAME   -- explicit flag (highest)
#   2. #@pipeline NAME   -- directive hardcoded in the script header; travels with
#                           the script (survives rename/copy) and needs no per-run flag
#   3. script basename   -- fallback; warns (but still runs) when it resolves to a
#                           GENERIC name (ambiguous across pipelines)
# The directive is read here by a pre-scan; the step loop below skips the directive
# line so it is never parsed as a step marker (real step markers start with a digit).
#
# A pipeline id is NORMALIZED then VALIDATED hard, because it becomes the first CSV
# column of every jobRecord row and the schema keys row-type detection on it:
#   * _ssNormPipe strips a trailing CR (CRLF files), keeps only the first token, and
#     maps any char outside [A-Za-z0-9_.-] to '_' (CSV/flag-safe);
#   * an id must then be non-empty, contain a NON-digit (jobRecordsEmitV2 detects a v2 data
#     row by a non-numeric first field, so an all-digit id silently drops every row
#     for that pipeline), and not be a reserved marker (legacy / unknown).
# An explicit bad name (--pipeline or #@pipeline) is a hard error; a degenerate
# basename falls through to the generic-name path.
_ssNormPipe() { printf '%s' "${1:-}" | tr -d '\r' | awk 'NR==1{printf "%s",$1; exit}' | tr -c 'A-Za-z0-9_.-' '_'; }
# Strip leading/trailing whitespace from a value. Used on the comma-separated #@
# marker fields so the README's documented spacing (`#@ step , deps , name , ...`),
# which stock master tolerated, keeps working after the numeric-grammar checks.
_ssTrim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

PIPELINE_SRC=flag
if [ -n "${PIPELINE_NAME:-}" ]; then
    PIPELINE_NAME=$(_ssNormPipe "$PIPELINE_NAME")
else
    PIPELINE_NAME=$(awk '
        /^[[:space:]]*#@[0-9]/ { exit }   # stop at the first step marker: a #@pipeline
                                          # inside a block body must not set identity
        /^[[:space:]]*#@pipeline([[:space:]]|=)/ {
            s=$0; sub(/^[[:space:]]*#@pipeline[[:space:]]*=?[[:space:]]*/,"",s); print s; exit
        }' "$PIPELINE_SCRIPT")
    PIPELINE_NAME=$(_ssNormPipe "$PIPELINE_NAME")
    if [ -n "$PIPELINE_NAME" ]; then
        PIPELINE_SRC=directive
        echolog1 "Pipeline name from #@pipeline directive: $PIPELINE_NAME"
    else
        PIPELINE_NAME=$(_ssNormPipe "$(basename "$PIPELINE_SCRIPT" .sh)")
        PIPELINE_SRC=basename
    fi
fi

_ssBadPipe=""
case "$PIPELINE_NAME" in
    legacy|unknown) _ssBadPipe="'$PIPELINE_NAME' is a reserved jobRecord marker" ;;
    1jobID|pipeline) _ssBadPipe="'$PIPELINE_NAME' collides with a jobRecord header line -- the schema would silently drop its rows" ;;
    *[!0-9]*)       : ;;                              # contains a non-digit -> valid
    '')             _ssBadPipe="empty after sanitizing" ;;
    *)              _ssBadPipe="all-digits ('$PIPELINE_NAME') -- the schema would drop its rows" ;;
esac
if [ -n "$_ssBadPipe" ]; then
    case "$PIPELINE_SRC" in
        flag)      echolog "Error: --pipeline name is invalid: $_ssBadPipe. Use a name with at least one letter (and not 'legacy'/'unknown')."; exit 1 ;;
        directive) echolog "Error: #@pipeline name in $PIPELINE_SCRIPT is invalid: $_ssBadPipe. Use a name with at least one letter (and not 'legacy'/'unknown')."; exit 1 ;;
        basename)  PIPELINE_NAME=generic ;;           # degenerate filename -> generic path ('generic' cannot collide with a header line; 'pipeline' can, when a step is named 'step')
    esac
fi

if [ "$PIPELINE_SRC" = basename ]; then
    case "$PIPELINE_NAME" in
        generic|run|script|main|workflow|test)
            # No unique pipeline name resolved. Warn and continue under the generic
            # default name -- no prompt, so neither an interactive run nor automation
            # is ever blocked. Just tell the user how to give the pipeline a real id.
            echolog "Warning: this pipeline has no unique name -- recording resource usage under the default name '$PIPELINE_NAME', which pools unrelated pipelines' steps and degrades estimation. Add '#@pipeline <name>' to the top of $PIPELINE_SCRIPT (or pass --pipeline <name>) to give it a stable, unique id." ;;
    esac
fi

# Sanctioned self-location variable for drivers: the directory of the --script,
# exported into submit scope so a driver can find its own repo / sibling assets
# (a config or helper that ships next to it). Submit-scope lines run from a generated
# copy under smartSlurmLog/, so $0 / BASH_SOURCE point THERE, not at the script's dir
# -- drivers must use $bashScriptPath, never $0/BASH_SOURCE, to self-locate. See
# docs/core-concepts.md ("Finding the pipeline script's own directory").
export bashScriptPath=`dirname "$PIPELINE_SCRIPT"`

if [ -z "$SBATCH_OPTIONS" ]; then 
    echolog Commandline sbatch option is empty. Please make sure all steps have sbatch options in your bash script.
elif [[ "$SBATCH_OPTIONS" != sbatch* ]]; then 
    SBATCH_OPTIONS="sbatch -p short -c 1 --mem 2G -t 50:0"
fi

[[ "$TMP_MODE" == useTmp ]] || [[ "$TMP_MODE" == noTmp ]] || usage

[[ -z "$RUN_MODE" ]] || [[ "$RUN_MODE" == dryrun ]] || usage

# --email: how cleanUp.sh emails you (default emailPerSample). noSuccEmail is the
# old name for failedJobOnly. Passed to every job as lessEmail.
[ -z "$EMAIL_MODE" ] && EMAIL_MODE=emailPerSample
[ "$EMAIL_MODE" = noSuccEmail ] && EMAIL_MODE=failedJobOnly
case "$EMAIL_MODE" in
    emailPerSample|allJobs|successJobOnly|failedJobOnly|requeueOnly|noEmail) ;;
    *) echolog "Unknown --email mode: $EMAIL_MODE"; usage ;;
esac
export lessEmail="$EMAIL_MODE"


if [ ! -z "$SPECIAL_MODE" ]; then
    if [[ "$SPECIAL_MODE" == checkpoint ]]; then
        checkpoint=".Checkpoint"
    elif [[ "$SPECIAL_MODE" == excludeFailedNodes ]]; then
        echolog1 "Excluding failed nodes"
    else 
        usage
    fi
else
    checkpoint=""
fi

#set -x

set -o pipefail

[ -f .smartSlurm.log ] && mv .smartSlurm.log .smartSlurm.log.$(stat -c '%.19z' .smartSlurm.log | cut -c 6- | tr " " . | tr ":" "-")

#[ -f log.out ] && mv log.out log.out.$(stat -c '%.19z' log.out | tr " " . | tr ":" "-")

current_date=$(date '+%Y-%m-%d_%H-%M-%S_%4N') 
echolog1 runAsPipeline run date: $current_date
[ "$VERBOSITY" != quiet ] && echolog "$output" || echo "$output" >> .smartSlurm.log

#echolog1 `module list`

if [ -f ~/.smartSlurm/config/config.txt ]; then

    if [ -f $(dirname $0)/../config/config.txt ]; then 
        if [ ~/.smartSlurm/config/config.txt -nt "$(dirname "$0")/../config/config.txt" ]; then
            echolog1 "~/.smartSlurm/config/config.txt is newer than $(dirname "$0")/../config/config.txt, using ~/.smartSlurm/config/config.txt"
        else
            echo "Error: ~/.smartSlurm/config/config.txt is older than $(dirname "$0")/../config/config.txt, using ~/.smartSlurm/config/config.txt"
            echo "Do you need to update it? Exiting..."
            exit 1
        fi 
    fi 

    echolog1 Config file path: ~/.smartSlurm/config/config.txt
    source ~/.smartSlurm/config/config.txt
else
    echolog1 Config file path: $(dirname $0)/../config/config.txt
    source $(dirname $0)/../config/config.txt || { echoerr Config list file not found: config.txt; exit 1; }
fi

[[ "$smartSlurmLogDir" == /* ]] || export smartSlurmLogDir=$PWD/$smartSlurmLogDir

[ -d $smartSlurmLogDir ] && [[ "$RUN_MODE" != dryrun ]] && cp -rp $smartSlurmLogDir $smartSlurmLogDir.$(stat -c '%.19z' $smartSlurmLogDir | cut -c 6- | tr " " "." | tr ":" "-")

mkdir -p $smartSlurmLogDir

# One-time jobRecord v1->v2 migration, done UP FRONT rather than lazily inside the
# first ssbatch. Migrating a legacy store emits a one-line notice; triggering it here
# (before the per-step submission progress table is printed) keeps that notice from
# splitting the first sample's row. Real submissions only -- a --lint / --mode dryrun
# must not mutate the store. jobRecordsMigrateStore is idempotent and silent once v2.
if [ "$RUN_MODE" != dryrun ] && [ -n "${smartSlurmJobRecordDir:-}" ] && [ -s "$smartSlurmJobRecordDir/jobRecord.txt" ]; then
    . "$(dirname "$0")/jobRecordSchema.sh" 2>/dev/null && jobRecordsMigrateStore "$smartSlurmJobRecordDir/jobRecord.txt"
fi

checkSum=`md5sum "$PIPELINE_SCRIPT" | cut -d' ' -f 1`

run=$smartSlurmLogDir/slurmPipeLine.$checkSum.sh
[ -z "$RUN_MODE" ] || run=$smartSlurmLogDir/slurmPipeLine.$checkSum.dryrun.sh
 
# Driver-reuse shortcut. NOTE: it is currently inert -- the stored last line carries a
# "#cmd: " prefix while $thisCmd does not, so they never match and the driver is always
# regenerated (with the current ssRerunDecide.sh call). ssbatch's no-scope-marker
# fallback is safe only because of that; if reuse is ever revived, a stale driver
# predating ssRerunDecide.sh could be reused -- ssbatch warns loudly in that case.
if [ -f "$run" ]; then
    #thisCmd="#cmd: $0 $@"
    lastCmd=`tail -n 1 $run`
    if [[ "$thisCmd" == "$lastCmd" ]]; then
        echolog This is a re-run with the same command and script is not changed, no need to convert the script. Using the old one: $run
        [[ "$PIPELINE_SPEC" = *" "* ]] && para=${PIPELINE_SPEC#* } || para=""
        eval "/bin/bash $run $para 2>&1" | tee -a .smartSlurm.log 
        exit
    fi
fi

[ "$VERBOSITY" != quiet ] && echolog ===========
[ "$VERBOSITY" != quiet ] && echolog Stage 1: Processing Pipeline
[ "$VERBOSITY" != quiet ] && echolog "    Converting pipeline to execution script ($PIPELINE_SPEC to $run)"

echo "#!/bin/sh" > $run

echo "#from cmd: $thisCmd" >> $run
echo "#run from: `pwd`" >> $run

echo "#set -x" >> $run

echo "echo Running \$0 \$@ >> .smartSlurm.log"  >> $run

echo "module list >> .smartSlurm.log 2>&1" >> $run

# Set an early exit flag to 'true'
echo early_exit=true >> $run

# Trap EXIT signal to print a warning if early_exit is true
echo "trap 'if \$early_exit; then echo "WARNING: Script exited early! Please review!!!"; fi' EXIT" >> $run

echo "xsubd=\"$SBATCH_OPTIONS\"" >> $run

# ---- A+ progress display (baked into the driver; verbosity read at runtime) ----
# ssV is taken from the environment so the same (md5-cached) driver serves all
# three levels: normal (default) = one appended-ASCII row per sample; verbose =
# the full per-job firehose; quiet = errors + final summary only. No CR / no
# in-place rewrite: each step appends "<step><glyph> " to the current row and a
# newline closes the row. Glyphs: + submitted, - kept(skipped), H held, X error.
cat >> $run <<'SSHELPERS'
ssV="${ssV:-normal}"
ssW="${ssSampleW:-48}"   # sample-column width; set ssSampleW to widen/narrow
ssCur=''; ssRowOpen=0; ssLastStep=''
ssSub=0; ssKept=0; ssErr=0; ssHdr=0; ssDryRun="${ssDryRun:-0}"
ssG() { case "$1" in
    +) __ssg=$'\033[32m\342\234\223\033[0m' ;;
    X) __ssg=$'\033[31m\342\234\227\033[0m' ;;
    -) __ssg=$'\033[2m-\033[0m' ;;
    *) __ssg="$1" ;; esac; }
ssFmt() {  # $1 label -> exactly ssW display cols. Long paths keep their tail (the
  # distinguishing part) with a leading … so the steps still line up in a column.
  local s="$1" n=${#1}
  if [ "$n" -gt "$ssW" ]; then printf '…%s' "${s:$((n-ssW+1))}"
  else printf '%-*s' "$ssW" "$s"; fi; }
ssHeader() { [ "$ssHdr" = 1 ] && return 0; ssHdr=1; [ "$ssDryRun" = 1 ] && return 0; [ "$ssV" = normal ] || return 0
  local d                       # scoped: must not clobber a user submit-scope var 'd'
  printf '  %-*s   %s\n' "$ssW" sample steps
  d=$(printf '%*s' "$((ssW+30))" ''); printf '  %s\n' "${d// /-}"; }
ssStart() {  # key label step -- print the step number BEFORE the submit (live "working on N")
  local x grp lbl               # scoped: must not clobber user submit-scope vars
  { [ "$ssV" = normal ] && [ "$ssDryRun" != 1 ]; } || return 0
  ssHeader
  if [ "$1" = __final ]; then grp=__final; else x="${1#.}"; grp=".${x%%.*}"; fi
  if [ "$grp" != "$ssCur" ]; then
    [ "$ssRowOpen" = 1 ] && printf '\n'
    ssCur="$grp"; ssLastStep=''
    if [ "$grp" = __final ]; then lbl="$2"; else lbl="${grp#.}"; fi
    lbl=$(echo $lbl); [ -z "$lbl" ] && lbl='(no input)'
    printf '  %s  ' "$(ssFmt "$lbl")"; ssRowOpen=1
  fi
  if [ "$3" != "$ssLastStep" ]; then printf ' %s' "$3"; ssLastStep="$3"; fi
  return 0
}
ssMark() {  # glyph -- append the outcome glyph once submission returns; tally
  local __ssg                   # scoped channel for ssG, so a user var 'g' is untouched
  case "$1" in +) ssSub=$((ssSub+1)) ;; -) ssKept=$((ssKept+1)) ;; X) ssErr=$((ssErr+1)) ;; esac
  { [ "$ssV" = normal ] && [ "$ssDryRun" != 1 ]; } || return 0
  ssG "$1"; printf '%s' "$__ssg"
  return 0
}
ssSummary() {
  [ "$ssRowOpen" = 1 ] && printf '\n'; ssRowOpen=0
  [ "$ssV" = quiet ] && return 0
  printf 'Submitted %s, kept %s, error %s.  Details: less .smartSlurm.log  |  checkRun to monitor.\n' "$ssSub" "$ssKept" "$ssErr"
}
SSHELPERS

# dry-run: suppress the compact per-sample progress row. A dry run prints a full
# per-step detail block (from `ssbatch ... dryrun`) that would otherwise interleave
# with and scatter the one-line row; the tallies and the final summary are unaffected.
[[ "$RUN_MODE" == dryrun ]] && echo "ssDryRun=1" >> $run

echo "rm \$smartSlurmLogDir/keepRunningJobs.txt 2>/dev/null" >> $run
echo "if [ -f \$smartSlurmLogDir/allJobs.txt ]; then" >> $run
echo "    cancelAllJobsReRun.sh" >> $run
echo "    [ \$? == 1 ] && exit 0;" >> $run
echo "fi" >> $run

echo "cwd=\`realpath ./\`" >> $run

#echo "rm \$smartSlurmLogDir/*.failed \$smartSlurmLogDir/*.killed 2>/dev/null" >> $run

#echo "[ -f \$smartSlurmLogDir/allJobs.txt ] && [ ! -f \$smartSlurmLogDir/keepRunningJobs.txt ] && mv \$smartSlurmLogDir/allJobs.txt \$smartSlurmLogDir/allJobs.txt.old"  >> $run

echo "[ -f \$smartSlurmLogDir/allJobs.txt ] && cp \$smartSlurmLogDir/allJobs.txt \$smartSlurmLogDir/allJobs.txt.old"  >> $run

echo "rm -r \$smartSlurmLogDir/downsteamjob.adjusting \$smartSlurmLogDir/job.adjusting.lock \$smartSlurmLogDir/requeue.start \$smartSlurmLogDir/skipAllSuccessJobs*.txt \$smartSlurmLogDir/reRunAllSuccessJobs*.txt \$smartSlurmLogDir/*requeued* 2>/dev/null" >> $run

echo "[ ! -f \$smartSlurmLogDir/keepRunningJobs.txt ] && printf \"%-10s   %-20s   %-10s   %-10s  %-10s %-10s %-10s\n\" job_id depend_on job_flag program reference inputs comment > \$smartSlurmLogDir/allJobs.txt || echo -e \"\n\`date\`\" >> \$smartSlurmLogDir/allJobs.txt">> $run
echo "[ \"\$ssV\" = verbose ] && echo ---------------------------------------------------------" >> $run

[ "$TMP_MODE" == "useTmp" ] && echo ". $(dirname $0)/utils.sh" >> $run

# Decide the re-run SCOPE once, up front -- BEFORE the progress table is drawn -- so
# the prompt can't fire mid-row inside the first already-completed step's ssbatch, and
# a dry run stays non-interactive. Writes the skip*/reRun* markers ssbatch reads; on
# 'cancel' it returns 2 and we abort cleanly. (${RUN_MODE:+dryrun} passes "dryrun" only
# on a dry run.)
echo "ssRerunDecide.sh ${RUN_MODE:+dryrun}; _ssRerunRC=\$?; [ \"\$_ssRerunRC\" = 2 ] && { early_exit=false; exit 0; }" >> $run

# get slurm account from command line
slurmAccount=""
if [[ "$SBATCH_OPTIONS" == *\ -A\ * ]]; then
    slurmAccount=${SBATCH_OPTIONS#*-A }
    slurmAccount="-A ${slurmAccount%% *}"
elif [[ "$SBATCH_OPTIONS" == *\ --account\ * ]]; then
    slurmAccount=${SBATCH_OPTIONS#*--account }
    slurmAccount="-A ${slurmAccount%% *}"
elif [[ "$SBATCH_OPTIONS" == *\ --account=* ]]; then
    slurmAccount=${SBATCH_OPTIONS#*--account\=}
    slurmAccount="-A ${slurmAccount%% *}"
elif [[ "$SBATCH_OPTIONS" == *\ --array=* ]]; then
    echolog Error: job array is not supported! $SBATCH_OPTIONS
    exit
elif [[ "$SBATCH_OPTIONS" == *\ -a\ * ]]; then
    echolog Error: job array is not supported! $SBATCH_OPTIONS
    exit
fi

if [[ "$SBATCH_OPTIONS" == *\ --mail-user=* ]]; then
    userEmail="--mail-user ${SBATCH_OPTIONS#*--mail-user=}"
    #export userEmail="${userEmail%% *}"
else 
    userEmail="";
fi

[ -z "$slurmAccount" ] && [ `sshare -Uu $USER | wc -l` -ge "4" ] && { echolog Missing slurm account: $SBATCH_OPTIONS; exit 1; } 

firstRowBelowLoopStart=""; findLoopStart=""; loopDepth=0

# M4: choose block-closure mode. If the pipeline uses '#@end' anywhere, the whole
# script is parsed in strict explicit-closure mode: blank lines are body, only
# '#@end' closes a block, and an unclosed block is an error. Otherwise the legacy
# blank-line-terminated behavior is used unchanged (full back-compat).
if grep -qE '^[[:space:]]*#@end([[:space:]]|$)' "$PIPELINE_SCRIPT"; then
    BLOCK_MODE=end
    echolog "Block mode: explicit (#@ ... #@end). Blank lines are treated as body."
else
    BLOCK_MODE=blank
fi
rm -f "$smartSlurmLogDir/.conversionError" 2>/dev/null   # M4: fresh per conversion
[ "$LINT_MODE" = yes ] && echolog "Linting $PIPELINE_SCRIPT (block mode: $BLOCK_MODE) ..."

{ cat "$PIPELINE_SCRIPT"; echo; echo; echo '#@__SMARTSLURM_EOF__'; } | while IFS= read -r t; do

    [ ! -z "$findLoopStart" ] && findLoopStart="" && firstRowBelowLoopStart=yes || firstRowBelowLoopStart=""

    echolog1 original row: .$t.

    # get space and the real command
    space=""; i=""
    for (( j=0; j<${#t}; j++ )); do
        chr=${t:$j:1}
        if [[ "$chr" == " " || "$chr" == $'\t' ]]; then
            space="$space$chr"
        else
           # i is the real command
           i="${t:$j:1000}"
           break
        fi
    done

    # this maybe a new command, remember the space
    [ -z "$cmd" ] && oldspace="$space"

    # M4: end-of-script sentinel. In explicit-closure mode a still-open block here
    # means the user forgot the closing #@end.
    if [[ "$i" == '#@__SMARTSLURM_EOF__' ]]; then
        [ -n "$findjob" ] && [ "$BLOCK_MODE" = end ] && { echolog "Error: step '$step' was opened with '#@' but never closed with '#@end' before the end of the script."; touch "$smartSlurmLogDir/.conversionError"; exit 1; }
        # Loop-nesting balance check: every 'for'/'#loopStart:' that pushed a loop
        # suffix must be matched by a 'done'. A non-zero depth here means a one-line
        # 'for ...; done' slipped through, a 'for' was miscounted, or a 'done' is
        # missing -- any of which would corrupt downstream job flags. Fail loudly
        # instead of emitting corrupted flags.
        [ "${loopDepth:-0}" -ne 0 ] && { echolog "Error: unbalanced loop nesting at end of script: $loopDepth loop(s) opened with 'for'/'#loopStart:' were never closed by a 'done'. Check for a one-line 'for ...; done', a 'for' with no simple loop variable, or a missing 'done'."; touch "$smartSlurmLogDir/.conversionError"; exit 1; }
        continue
    fi

    # M4: an '#@end' with no open block is an orphan (or a duplicate close, e.g.
    # the second end in '#@ ... #@end #@end'). Report it with the line.
    if { [[ "$i" == \#@end ]] || [[ "$i" == \#@end\ * ]]; } && [ -z "$findjob" ]; then
        echolog "Error: '#@end' found with no open '#@ ...' step to close (orphan or duplicate #@end). Near: $t"
        touch "$smartSlurmLogDir/.conversionError"; exit 1
    fi

    # '#@pipeline NAME' is a header directive (pipeline identity, read in the pre-scan
    # before this loop), NOT a step marker. A line starting with '#@pipeline' is only
    # ever this directive (real step markers start with a digit, e.g. '#@1,...'), so
    # skip the valid form and reject a malformed one (e.g. '#@pipelineFoo') with a
    # clear message instead of letting it fail as a bogus step marker below.
    # Only treat '#@pipeline' as a header directive when NOT inside an open block;
    # inside a block body it is ordinary content (it falls through to the verbatim
    # capture below), so a pasted heredoc/comment line can contain it safely.
    if [ -z "$findjob" ]; then
    case "$i" in
      '#@pipeline'*)
        if [[ "$i" =~ ^#@pipeline([[:space:]=]|$) ]]; then
            echolog1 "    (pipeline directive line, applied in pre-scan: $i)"; continue
        else
            echolog "Error: malformed '#@pipeline' directive (use '#@pipeline <name>'). Near: $t"
            touch "$smartSlurmLogDir/.conversionError"; exit 1
        fi ;;
    esac
    fi

    if [[ "$i" == \#@* ]] && [[ "$i" != \#@end* ]]; then

        # M4: a new '#@' step while still inside a block means the previous block
        # was never closed (no blank line and no #@end) -- the ambiguous
        # "consecutive starts" case. Report it with the line instead of silently
        # swallowing the following lines.
        [ ! -z "$findjob" ] && { echolog "Error: new '#@' step marker found before the previous step was closed (add a blank line or an #@end). Near: $t"; touch "$smartSlurmLogDir/.conversionError"; exit 1; }

        echolog1 "    Recognized job step: $i"

        findjob="yes"
        x=${i#*\#@}
        # #@1,0,find1,ref,input1.input2,sbatch -p short -c 1 -t 50:0

        # ssbatch -L ./ -P bowtie2-4core -R dm3 -F bowtie.group1 -I group1/tumor1 -c 4 -t 12:0:0 --mem 20G  job1BowtieGroup1.sh run
        IFS=',' read -a arrIN <<< "$x"
        IFS=''

        step=${arrIN[0]}
        de=${arrIN[1]}
        name=${arrIN[2]%%:*}; [[ "$name" == *.NoCheckpoint ]] && name=${name%.NoCheckpoint} || name=$name$checkpoint
        #indx=${arrIN[3]}
        ref=${arrIN[3]%%:*} # references files which need to rsync to tmp space
        inputs=${arrIN[4]}
        xsuba=${arrIN[5]}  # sbatch options

        # Back-compat: the README's format shows spaces around the commas
        # (`#@ step , deps , name , ref , inputs , ...`) and stock master tolerated
        # them. Trim the identifier fields so the numeric-grammar checks below don't
        # reject a leading space (e.g. dep ' 0'); sbatch options keep their spacing.
        step=$(_ssTrim "$step"); de=$(_ssTrim "$de"); name=$(_ssTrim "$name"); ref=$(_ssTrim "$ref"); inputs=$(_ssTrim "$inputs")

        ( [ -z "$step" ] || [ -z "$de" ] || [ -z "$name" ] ) && echolog Job marker \"$i\" is wrong. The first three parameters cannot be empty. Please refer README.md for correct format! && exit

        # The step number and its dependency(ies) are used as array indices and in
        # arithmetic ($(( )) / jobID[]), so they MUST be numeric. Enforce it here: a
        # non-numeric step (e.g. "foo") was silently accepted and broke DAG wiring, and
        # an alphanumeric one (e.g. "1x") leaked a raw bash arithmetic error. Reject
        # both with a clear message. step: a positive integer, NO leading zero; dep:
        # numeric step number(s) (no leading zero), dot-joined (0 = no dependency).
        # Leading zeros are rejected because step/dep index bash arrays/arithmetic,
        # where e.g. "08"/"09" leak "value too great for base" and "010" is read octal.
        if ! [[ "$step" =~ ^[1-9][0-9]*$ ]]; then
            echolog "Job marker \"$i\" is wrong: the step number (first field) must be a positive integer with no leading zero (it indexes bash arrays / arithmetic, where a leading zero is invalid or is silently misread as octal), got '$step'. Please refer README.md for correct format!"
            touch "$smartSlurmLogDir/.conversionError"; exit 1
        fi
        if ! [[ "$de" =~ ^(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*))*$ ]]; then
            echolog "Job marker \"$i\" is wrong: the dependency (second field) must be numeric step number(s) with no leading zero, dot-joined (use 0 for none), got '$de'. Please refer README.md for correct format!"
            touch "$smartSlurmLogDir/.conversionError"; exit 1
        fi

        # if it is old format bash job annotation without inputs
        [[ "$name$ref$inputs" == *sbatch* ]] && echolog Job marker \"$i\" is wrong. Please refer README.md for correct format! && exit

        [ ! -z "$xsuba" ] && [[ "$xsuba" != sbatch* ]] && echolog Job marker \"$i\" is wrong. Please refer README.md for correct format! && exit

        [ ! -z "$xsuba" ] && { echo "${space}xsub=\"$xsuba $slurmAccount\"" >> $run; echolog1 final sbatch options: $xsuba; } || echo "${space}xsub=\"\$xsubd\"" >> $run
        
        if [[ "$xsuba" == *\ --array=* ]]; then
            echolog Error: job array is not supported! $xsuba
            exit
        elif [[ "$xsuba" == *\ -a\ * ]]; then
            echolog Error: job array is not supported! $xsuba
            exit
        fi

        # echolog run content:
        # tail $run
        # exit

        [ -z "$ref" ] || ref=.$ref
        [ -z "$inputs" ] || inputs=.$inputs

        echo "$t" >> $run

        echolog1 "    It is treat as: step: $step, depends on: $de, job name: $name, reference: $ref, inputs: $inputs, sbatch options: $xsuba"
        #echolog 
        #echo step is $step
        #echo de is $de
        #echo name is $name
        cmd=""
        rawBody=""            # M4: raw multi-line body (for #@end scripts-on-disk)
        vbody=""              # T2: VERBATIM body for #@end (no escaping; quoted here-doc)
        blockClosedBy=""      # M4: "blank" (legacy) or "end" (#@end)

    elif [ ! -z $findjob ]; then

        # M4: explicit block terminator. '#@end' closes the current block; it is
        # handled here (not as a comment) and does not become part of the body.
        if [[ "$i" == \#@end || "$i" == \#@end\ * ]]; then
            blockClosedBy="end"
            echolog1 "    Found #@end (explicit block close)"
            # fall through to finalize below (do not accumulate this line)
        else
        if [ "$BLOCK_MODE" = end ]; then
            # T2: capture the #@end body VERBATIM from the raw line ($t) -- comments,
            # blank lines, backslash continuations and leading indentation are all
            # preserved, so a bash chunk pasted from elsewhere round-trips byte-for-byte
            # into cmd.sh. Only #@end (handled above) closes the block.
            [[ "$i" == ssbatch* ]] && { echolog Error! Please remove ssbatch command from $PIPELINE_SPEC.; exit 1; }
            vbody="$vbody$t"$'\n'
            continue
        fi
        [[ "$i" == \#* ]] && { echo "$t" >> $run; continue; }
        #echolog
        echolog1 "    find job: $i"
        [[ "$i" == ssbatch* ]] && echolog Error! Please remove ssbatch command from $PIPELINE_SPEC. && exit 1

        [ -z "$cmd" ] && cmd="${i%\\}" || cmd="$cmd ${i%\\}" 
        cmd="${cmd%% #*}"; cmd="$(echo $cmd | xargs)" # remove comments and trim space
        cmd="$cmd;";  

        # M4: keep the raw line too (newline-preserved) for scripts-on-disk
        rawBody="$rawBody${rawBody:+
}${i%\\}"

        if [ "$BLOCK_MODE" = end ]; then
            # explicit mode: blank lines are body; only #@end (handled above) closes
            continue
        fi
        [[ -z "$t" || -z "$(echo $t | xargs)" ]] && { echolog1 "    Find empty line"; blockClosedBy="${blockClosedBy:-blank}"; } || continue
        fi
        
        echolog1 "    $cmd --before parsing"

        # check to see if we need escape bash variables
        IFS=';'; tmp=''
        for c in ${cmd%% #*}; do
            [[ -z $(echo $c | xargs) ]] && continue
            vs=$(echo $c | grep -oP '\$\w+|\$\{\w+\}|\$\{\w+\#|\$\{\w+\%|\$\{\w+\/' | tr -d '${}#%/' | sort -u | tr '\n' ';')
            # find bash vaiable such as $abc, ${abc}, ${abc#..., ${abc%... or ${abc/...
            for v in $vs; do
                #echo working on .$v.
                pat="* $v\=*"
                # has variable assignment in the command, for example "z='abc'; k=$z; x=${z//c/ }; x=${z#a}; x=${z%%b*};", so we need escapte $z...
                [[ " $tmp" == $pat ]] && { c=${c//\$$v/\\\$$v}; c=${c//\${$v/\\\$\{$v}; }
            done
            [ -z "$tmp" ] && tmp="$c;" || tmp="$tmp$c;"
            #echo ."$tmp".
        done
        #set +x

        cmd="$tmp"
        echolog1 "    $cmd" --after parseing
        space="$oldspace"

        # T2: the #@end body is emitted VERBATIM (quoted here-doc, see below), so no
        # per-line escaping is done here. Instead we enumerate the submit-scope
        # variables the body references, to bake their values into cmd.sh at driver
        # runtime. We bake every referenced NAME that is set at driver runtime and is
        # not a dynamic/per-node or Slurm-job variable (those must reflect the node,
        # not the submit host). In-block assignments in the verbatim body naturally
        # override a baked value, so names serving double duty still behave correctly.
        if [ "$blockClosedBy" = end ]; then
            bakeList=""; bakePos=""; bakeInd=""
            # Per-node / environment / shell vars: never bake -- these must reflect the
            # NODE the job runs on, not the submit host. (Baking is visible in cmd.sh, so
            # a miss here is an auditable wrong-value, never silent body corruption.)
            _t2deny=" HOME USER LOGNAME SHELL SHLVL TERM PATH LD_LIBRARY_PATH MANPATH PYTHONPATH TMPDIR TMP TEMP HOSTNAME HOSTTYPE OSTYPE MACHTYPE UID EUID GROUPS IFS COLUMNS LINES PWD OLDPWD RANDOM SRANDOM SECONDS LINENO BASHPID PPID EPOCHSECONDS EPOCHREALTIME PIPESTATUS FUNCNAME BASH_SUBSHELL BASH_COMMAND BASH_LINENO BASH_SOURCE "
            # driver-internal names: never bake, so a pasted body reusing one of these as
            # its own variable gets node scope rather than inheriting SmartSlurm state.
            _t2deny+=" flag deps id xsub ssKey ssLabel nJobsInSameStep alljobs green red green1 red1 jobID jobIDs depWasUsed __ssbakev __ssd __ssf __ssnv __ssptr __sstgt __ssnames "
            # persistent driver globals (not local-izable): a body reusing one of these
            # names must get node scope, not the driver's submit-time value.
            _t2deny+=" cwd early_exit xsubd ssV ssW ssCur ssRowOpen ssLastStep ssSub ssKept ssErr ssHdr "
            # match $name, ${name, ${#name (length), ${!name (indirect), ${name[...]}
            _t2names=$(printf '%s' "$vbody" | grep -oE '[$]\{?[#!]?[A-Za-z_][A-Za-z0-9_]*' | sed -E 's/^[$]\{?[#!]?//' | sort -u)
            IFS=$' \t\n'
            for _n in $_t2names; do
                [[ "$_t2deny" == *" $_n "* ]] && continue
                [[ "$_n" == SLURM_* ]] && continue
                bakeList="$bakeList $_n"
            done
            # Indirect expansion ${!ptr}: the pointer name 'ptr' is baked above, but the
            # variable it NAMES must be frozen at submit time too (master expanded ${!ptr}
            # at submit time; a verbatim body would otherwise read it empty on the node).
            # We can't resolve the pointer here -- its value is only known at driver
            # runtime -- so we collect the pointer names used as a TRUE indirect ref
            # ${!name} (brace closes right after the name) and let the driver resolve +
            # bake their targets (see the emit below). ${!arr[@]} (keys) and ${!pre*} /
            # ${!pre@} (name-match) are deliberately excluded: those are not value refs.
            for _p in $(printf '%s' "$vbody" | grep -oE '[$][{]![A-Za-z_][A-Za-z0-9_]*[}]' | sed -E 's/^[$][{]!//; s/[}]$//' | sort -u); do
                [[ "$_t2deny" == *" $_p "* ]] && continue
                [[ "$_p" == SLURM_* ]] && continue
                bakeInd="$bakeInd $_p"
            done
            # positional params / $@ / $* / $# referenced -> bake via 'set --'
            printf '%s' "$vbody" | grep -qE '[$]([0-9]|[@*#])' && bakePos=yes
            # T2: warn (never auto-fix) on invisible paste-gremlin bytes kept
            # verbatim in the body -- CRLF/NBSP/zero-width/BOM/exotic spaces, etc.
            _ssGremlinScan "$step" <<<"$vbody"
            IFS=''
        fi
        #

        #echo after remove space: ."$cmd".
        findjob=""
        [ ! -z ${find[$step]} ] && { echolog job step id should be unique: $step exiting...; exit 1; } ||  find[$step]=yes

        # don't need this anymore, because we are uing single quotation in srun command
        cmd=${cmd//\"/\\\"} # escape double quotes

        cmd=${cmd//\'/\\\"} # escape single quotes to double

        cmd=${cmd//\$(/\\\$(} # escap $((a+b)) and $(command)

        cmd=${cmd//\`/\\\`} # escape `

        # escape double quota. bsub does not need this? not sure
        #cmd=${cmd//\"/\\\\\"}

        echolog1 "    cmd: >>>$cmd<<<"

        [ -z "$name" ] && name=${cmd%% *}

        cloper[$step]=$loper
        # IFS=' '
        # if [[ "$de" == *\.* ]]; then
        #     for dep in ${de//\./ }; do
        #         l=$(expr length ${cloper[$step]} 2>/dev/null) || l=0
        #         ll=$(expr length ${cloper[$dep]} 2>/dev/null) || ll=0
        #         if [ $l -ge $ll ]; then
        #             sameLoop=""
        #             break 
        #         else
        #             sameLoop="yes"
        #         fi
        #     done
        # else
        #     #echolog $step:${cloper[$step]}:$de:${cloper[$de]}:
        #     l=$(expr length ${cloper[$step]} 2>/dev/null) || l=0
        #     ll=$(expr length ${cloper[$de]} 2>/dev/null) || ll=0
        #     [ $l -ge $ll ] && sameLoop="" || sameLoop="yes"
        # fi

        #echo "debug: ${cloper[$step]} ${cloper[$de]} .$sameLoop. " >> $run
        [ "$TMP_MODE" == "useTmp" ] && useTmp="reference: $ref"

        #echo -e "${space}echo Working on step: $step, depends on: $de, job name: $name, flag: ${step}.$de.$name$loper  $useTmp " >> $run
        echo -e "${space}echo step: $step, depends on: $de, job name: $name, flag: ${step}.$de.$name$loper $useTmp >> .smartSlurm.log " >> $run

        #echo -e "${space}echo For input: \$inputs" >> $run

        # echo -e "${space}echo Working on step: $step, depends on: $de, job name: $name, flag: ${step}.$de.$name$loper  $useTmp " >> $run
        # echo -e "${space}echo step: $step, depends on: $de, job name: $name, flag: ${step}.$de.$name$loper $useTmp >> .smartSlurm.log " >> $run


        echo "${space}flag=${step}.$de.$name$loper"  >> $run
        echo "${space}flag=\${flag//\//_}" >> $run   # replace path / to _

        echo -e "${space}deps=\"\""  >> $run
        #if [[ "$de" != "0" ]]; then
            IFS=' ' # xxx
            if [[ "$de" == *\.* ]]; then
                for dep in ${de//\./ }; do
                    l=$(expr length ${cloper[$step]} 2>/dev/null) || l=0
                    ll=$(expr length ${cloper[$dep]} 2>/dev/null) || ll=0
                    if [ $l -eq $ll ]; then
                        echo "${space}[ -z \"\${jobID[$dep]}\" ] || deps=\"\$deps:\${jobID[$dep]}\"" >> $run 
                    else
                        echo "${space}[ -z \"\${jobIDs[$dep]}\" ] || deps=\"\$deps:\${jobIDs[$dep]}\"" >> $run
                        echo "${space}depWasUsed[$dep]=\"yes\"" >> $run 
                    fi          
                done 

            else
                l=$(expr length ${cloper[$step]} 2>/dev/null) || l=0
                ll=$(expr length ${cloper[$de]} 2>/dev/null) || ll=0
                if [ $l -eq $ll ]; then 
                    echo "${space}[ -z \"\${jobID[$de]}\" ] || deps=\":\${jobID[$de]}\""  >> $run
                else     
                    echo "${space}[ -z \"\${jobIDs[$de]}\" ] || deps=\":\${jobIDs[$de]}\""  >> $run
                    echo "${space}depWasUsed[$de]=\"yes\"" >> $run
                fi
            fi     
        #fi

        

        [ -z "$inputs" ] && inputs=none
        [ -z "$ref" ] && ref=none

        # move to ssbatch? 
        #echo "set -x" >> $run 
        #echo "${space}comment=\"\"" >> $run
        # for jobs with no dep, check if there is formula yet, if yes, directly submit.
        # otherwise, only allow the first 10 jobs to run
        echo "${space}if [ -z \"\$deps\" ]; then" >> $run
        #echo "${space}    [[ \"\$inputs\" == none ]] && [ -f \"\$smartSlurmJobRecordDir/stats/$name.$ref.memTime.stat.noInput\" ] && hasFormula=y || hasFormula=\"\"" >> $run
        #echo "${space}    [[ \"\$inputs\" != none ]] && [ -f \"\$smartSlurmJobRecordDir/stats/$name.$ref.mem.stat\" ] && hasFormula=y || hasFormula=\"\"" >> $run
        #echo "${space}    if [ -z \"\$hasFormula\" ]; then" >> $run 

        echo "${space}        nJobsInSameStep=\$(echo \"\${jobIDs[$step]}\" | tr -cd ':' | wc -c)" >> $run
        echo "${space}        if [[ \"\$nJobsInSameStep\" -ge $((firstBatchCount-1)) ]]; then" >> $run
        echo "${space}            deps=\"-H\"" >> $run
        echo "${space}        fi" >> $run
        #echo "${space}    fi" >> $run  
        echo "${space}else" >> $run
        echo "${space}    deps=\"-H -d afterok\$deps\"" >> $run
        echo "${space}fi" >> $run 
        
        #echo "set +x" >> $run 
        
        #cmd="{set -e; $cmd;}" # && touch \$cwd/\$flag.success || touch \$cwd/\$flag.failed"
        #cmd="set -e; $cmd" # && touch \$cwd/\$flag.success || touch \$cwd/\$flag.failed"

        [[ "$SPECIAL_MODE" == excludeFailedNodes ]] &&  excludeFailedNode="-X"

        [ "$LINT_MODE" = yes ] && [ "$blockClosedBy" = blank ] && echolog "Lint: step '$step' ($name) uses legacy blank-line closure; consider '#@ ... #@end' for an explicit block."

        # A+ progress: sample key (loop suffix; experiment-level -> __final) and a
        # filename label (the job's input; falls back to the step name).
        echo "${space}ssKey=\"$loper\"; [ -z \"\$ssKey\" ] && ssKey='__final'" >> $run
        echo "${space}ssLabel=\"${inputs//./ $}\"; ssLabel=\$(echo \$ssLabel); { [ -z \"\$ssLabel\" ] || [ \"\$ssLabel\" = none ]; } && ssLabel='$name'" >> $run
        echo "${space}ssStart \"\$ssKey\" \"\$ssLabel\" \"$step\"" >> $run

        if [ "$blockClosedBy" = end ]; then
            # ---- T2 scripts-on-disk (explicit #@end block) ----
            # The driver writes a per-job script jobs/<flag>/cmd.sh as:
            #   [shebang] [submit-scope var bakes] [VERBATIM body]
            # The body goes through a QUOTED here-doc (<<'EOF'), so arbitrary bash --
            # nested quotes, embedded here-docs, backslashes, $(...), backticks --
            # round-trips byte-for-byte with no escaping. Submit-scope values (loop
            # variables, pre-block vars) are resolved NOW via %q-safe assignments
            # prepended to the script; in-block assignments in the body override them.
            # The exact bytes that run are persisted per job (conflict-free reruns).
            [[ "$TMP_MODE" == "useTmp" ]] && [[ "$ref" != none ]] && echo "${space}setPath $ref" >> $run
            echo "${space}mkdir -p \$smartSlurmLogDir/jobs/\$flag" >> $run
            echo "${space}{ echo '#!/bin/bash'" >> $run
            [[ "$TMP_MODE" == "useTmp" ]] && [[ "$ref" != none ]] && echo "${space}echo \"rsyncToTmp ${ref//./ \$}\"" >> $run
            # bake each set submit-scope var. Gate on `declare -p` success (true for ANY
            # set var, incl. associative and sparse arrays with no index/key 0 -- a
            # ${!v+x} test would wrongly skip those). Classify by the declare FLAGS, not by
            # '=(' in the text (a scalar value may contain '=('): a flag string with a/A is
            # an array -> re-emit as bare 'declare -a/-A name=(...)', dropping other
            # attributes (-i/-r/-x/-n) so the node copy carries submit-host VALUE but not
            # submit-host attributes (e.g. an integer array must not coerce an in-body
            # string assignment on the node). Scalars bake readably via %q.
            if [ -n "$bakeList" ] || [ -n "$bakeInd" ]; then
                # the bake set = statically-enumerated names, plus (resolved at driver
                # runtime) the target each indirect pointer ${!ptr} names.
                echo "${space}__ssnames='$bakeList'" >> $run
                [ -n "$bakeInd" ] && echo "${space}for __ssptr in$bakeInd; do __sstgt=\${!__ssptr}; [[ \$__sstgt =~ ^[A-Za-z_][A-Za-z0-9_]*\$ ]] && __ssnames=\"\$__ssnames \$__sstgt\"; done" >> $run
                echo "${space}for __ssbakev in \$__ssnames; do __ssd=\$(declare -p \"\$__ssbakev\" 2>/dev/null) || continue; __ssf=\${__ssd#declare -}; __ssf=\${__ssf%% *}; case \$__ssf in *[aA]*) __ssnv=\${__ssd#declare -* }; case \$__ssf in *A*) printf 'declare -A %s\\n' \"\$__ssnv\";; *) printf 'declare -a %s\\n' \"\$__ssnv\";; esac;; *) printf '%s=%q\\n' \"\$__ssbakev\" \"\${!__ssbakev}\";; esac; done" >> $run
            fi
            # positional params: only emit values when the driver actually has some, so a
            # no-arg pipeline does not fabricate an empty 'set -- '"''"' (which made $# == 1).
            [ -n "$bakePos" ] && echo "${space}{ printf 'set --'; ((\$#)) && printf ' %q' \"\$@\"; printf '\\n'; }" >> $run
            # Pick a here-doc terminator that does NOT appear as a standalone line in the
            # body, so a body line that happens to equal it cannot close the here-doc
            # early (which would silently truncate cmd.sh and leak the rest into the driver).
            EOFMARK=SMARTSLURM_CMD_EOF
            while printf '%s' "$vbody" | grep -qxF "$EOFMARK"; do EOFMARK="SMARTSLURM_CMD_EOF_${RANDOM}${RANDOM}"; done
            echo "${space}cat <<'$EOFMARK'" >> $run
            printf '%s' "$vbody" >> $run
            echo "$EOFMARK" >> $run
            echo "${space}} > \$smartSlurmLogDir/jobs/\$flag/cmd.sh" >> $run
            if [[ "$RUN_MODE" == dryrun ]]; then
                echo "${space}id=\$(ssbatch $excludeFailedNode -P $name --pipeline=$PIPELINE_NAME -R ${ref//./$} -F \$flag -I ${inputs//./,$} $userEmail \$deps $slurmAccount \${xsub#sbatch } \$smartSlurmLogDir/jobs/\$flag/cmd.sh dryrun)" >> $run
            else
                echo "${space}id=\$(ssbatch $excludeFailedNode -P $name --pipeline=$PIPELINE_NAME -R ${ref//./$} -F \$flag -I ${inputs//./,$} $userEmail \$deps $slurmAccount \${xsub#sbatch } \$smartSlurmLogDir/jobs/\$flag/cmd.sh) " >> $run
            fi
        else
            # ---- legacy blank-line block: flattened --wrap (unchanged) ----
            [[ "$TMP_MODE" == "useTmp" ]] && [[ "$ref" != none ]] && echo "${space}setPath $ref" >> $run && cmd="rsyncToTmp ${ref//./ $}; $cmd"

            if [[ "$RUN_MODE" == dryrun ]]; then 
                echo "${space}id=\$(ssbatch $excludeFailedNode -P $name --pipeline=$PIPELINE_NAME -R ${ref//./$} -F \$flag -I ${inputs//./,$} $userEmail \$deps $slurmAccount \${xsub#sbatch } --wrap \"$cmd\" dryrun)" >> $run
            else 
               echo "${space}id=\$(ssbatch $excludeFailedNode -P $name --pipeline=$PIPELINE_NAME -R ${ref//./$} -F \$flag -I ${inputs//./,$} $userEmail \$deps $slurmAccount \${xsub#sbatch } --wrap \"$cmd\") " >> $run
            fi 
        fi
        echo "${space}green=\"\\033[0;32m\$id\\033[0m\n\"" >> $run
        echo "${space}red=\"\\033[0;31m\$id\\033[0m\n\"" >> $run
        echo "${space}green1=\"Got output from ssbatch: \\033[0;32m\$id\\033[0m\n\"" >> $run
        echo "${space}red1=\"Got output from ssbatch: \\033[0;31m\$id\\033[0m\n\"" >> $run
       
        #echo "${space}echo -e \"\$red \$green\"  ">> $run
        
        # clear jobIDs if the ids were used in the previous downstream step 
        echo "${space}    if [ ! -z \"\${depWasUsed[$step]}\" ]; then" >> $run
        echo "${space}        jobIDs[$step]=''" >> $run
        echo "${space}        depWasUsed[$step]=\"\"" >> $run
        echo "${space}    fi" >> $run

        # GREEN='\033[0;32m' RED='\033[0;31m' NC='\033[0m' # No Color 
        echo "${space}[[ \"\$id\" == *\"missingInputFile\"* ]] && echo -e \"\$red\" && exit ">> $run

        #echo "${space}[[ \"\$id\" == *\"thisJobStillRunning\"* ]] && echo -e \"\$id\n\" && id=\"\" ">> $run

        echo "${space}[[ \"\$id\" == *\"Submitted batch job \"* ]] && { [ \"\$ssV\" = verbose ] && echo -e \"\$green\"; echo -e \"\$green1\" >> .smartSlurm.log; id=\${id##*Submitted batch job }; id=\${id%% *}; }">> $run

        echo "${space}[[ \"\$id\" == *\"thisJobStillRunning\"* ]] && { [ \"\$ssV\" = verbose ] && echo -e \"\$green\"; echo -e \"\$green\" >> .smartSlurm.log; id=\${id##*thisJobStillRunning }; id=\${id%% *}; }">> $run

        [[ "$TMP_MODE" == "useTmp" && ! -z "$ref" ]] && echo "${space}setPathBack $ref" >> $run

        echo "${space}if [[ \"\$id\" == *skipThisJob* ]]; then"  >> $run
        echo "${space}    [ \"\$ssV\" = verbose ] && echo -e \"\$green\" " >> $run 
        echo "${space}    ssMark \"-\"" >> $run
        echo "${space}    jobID[$step]=\"\"" >> $run
        echo "${space}elif [[ \"\$id\" == *\"thisJobStillRunning\"* ]]; then" >> $run
        echo "${space}    id=\${id##*thisJobStillRunning } && jobID[$step]=\${id%% *}">> $run
        echo "${space}    ssMark \"+\"" >> $run

        echo "${space}elif [[ \"\$id\" =~ ^[0-9]+\$ ]]; then"  >> $run
        #echo "${space}    touch \$cwd/\$flag.submitted" >> $run
        echo "${space}    alljobs=\"\$alljobs \$id\"" >> $run
        echo "${space}    ssMark \"+\"" >> $run

        # # tell this is out of the loop for the depending job (de), so that we clear the job id list for the next step with depends on 'de'
        # if [[ "$de" == *\.* ]]; then
        #        for dep in ${de//\./ }; do
        #             [[ "$sameLoop" == "yes" ]] && echo "${space}    startNewLoop[$dep]=\"yes\""  >> $run || echo "    ${space}startNewLoop[$dep]=\"no\""  >> $run
        #        done
        # else
        #        [[ "$sameLoop" == "yes" ]] && echo "${space}    startNewLoop[$de]=\"yes\""  >> $run || echo "    ${space}startNewLoop[$de]=\"no\""  >> $run
        # fi

        #echo "${space}    [[ \"\${startNewLoop[$dep]}\" == \"yes\" ]] && jobIDs[$dep]=\"\" && startNewLoop[$step]=\"no\" " >> $run

        echo "${space}    jobID[$step]=\$id"  >> $run # xxxx
            
        echo "${space}    [ -z \"\${jobIDs[$step]}\" ] && jobIDs[$step]=\$id || jobIDs[$step]=\${jobIDs[$step]}:\$id"  >> $run

        echo "${space}else" >> $run
        echo "${space}    ssMark \"X\"" >> $run
        echo "${space}    echo -e \"\$red\" && echo -e \"\\033[0;31mJob \$flag is not submitted!\\033[0m\""  >> $run
        #echo "${space}    echo Please check .smartSlurm.log for detail logs." >> $run
        echo "${space}    exit 1"  >> $run

        echo "${space}fi" >> $run
        IFS=''
        cmd=""
    else
        [[ -n "$t" ]] && echo "$t" >> $run
        #findjob=""

        #if [[ "$i" == \#loopEnd* ]]; then
        #    echo find loop end: $i
        #    space=${space%    }
        #    loper=${loper%.\$*}
        fw="${i%% *}"      # first space-delimited word of the (leading-trimmed) line
        if [[ "$i" == \#loopStart:* ]]; then
            #a=`echo $i | xargs`  # remove leading space and tailing space
            a=${i#\#loopStart:}; a=${a%% *}
            # '#loopStart:VAR' is the explicit way to declare a fan-out loop variable
            # (for while/until/C-style loops, or any case auto-detection can't read).
            # Validate it the same way as an auto-detected 'for' variable so a
            # malformed marker warns instead of pushing a garbage flag suffix.
            if [[ "$a" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                echolog1; echolog1 find loop start: $i
                loper="$loper.\$$a"; loopDepth=$((loopDepth+1))
                findLoopStart=yes
            else
                echolog1 "Warn: '#loopStart:' with an invalid or empty loop variable (ignored): $i  (expected '#loopStart:NAME')"
            fi
        elif [ "${fw%;}" = done ]; then
            # Close a loop only when 'done' is the FIRST WORD of the line. A 'done'
            # mid-line (e.g. a one-line 'for ...; done') is handled on the 'for'
            # side; a line like 'done_file=...' is not a loop close.
            echolog1 "find loop end: $i"
            #space=${space%    }
            if [ "$loopDepth" -gt 0 ]; then loper=${loper%.\$*}; loopDepth=$((loopDepth-1))
            else echolog1 "Warn: 'done' with no open loop (ignored): $t"; fi
        elif [ "$fw" = for ]; then
            # Open a loop only when 'for' is the FIRST WORD (so 'format...',
            # 'foremost...', 'foreach...' are NOT misread as loops), and only when
            # it actually introduces a fan-out loop variable.
            if [ ! -z "$firstRowBelowLoopStart" ]; then
                firstRowBelowLoopStart=""                       # real 'for' after #loopStart: already counted
            elif [[ "$i" == *[\ \;]done || "$i" == *[\ \;]done[\ \;]* ]]; then
                # one-line 'for ... ; done': opens and closes on the same line, so it
                # wraps no step and must not push a suffix (it would never be popped).
                echolog1 "one-line for...done (no fan-out), ignored: $i"
            else
                a=${i#* }; a=${a%% *}                            # the loop variable, right after 'for'
                if [[ "$a" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
                    echolog1; echolog1 find for loop start: $i
                    loper="$loper.\$$a"; loopDepth=$((loopDepth+1))
                else
                    # not a plain 'for VAR in ...' (e.g. C-style 'for ((...))'): no
                    # positional loop variable. Use '#loopStart:VAR' to fan out flags.
                    echolog1 "Warn: 'for' without a simple loop variable (no fan-out suffix): $i  (use #loopStart:VAR)"
                fi
            fi
        #    loper="$loper.for"
        #else

        #elif [[ "$i" == while* ]]; then
        #    echo; echo find loop start: $i
            #a=`echo $i | xargs`  # remove leading space and tailing space
            #a=whiele #${a#* }; a=${a%% *}
        #    loper="$loper.while"
        #elif [[ "$i" == until* ]]; then
        #    echo; echo find loop start: $i
            #a=`echo $i | xargs`  # remove leading space and tailing space
            #a=whiele #${a#* }; a=${a%% *}
        #    loper="$loper.until"
        fi
    fi
done 

convRc=$?
# M4: conversion-error handling + lint reporting
if [ -f "$smartSlurmLogDir/.conversionError" ]; then
    rm -f "$smartSlurmLogDir/.conversionError" 2>/dev/null
    [ "$LINT_MODE" = yes ] && echolog "Lint: FAILED — fix the block-closure error(s) above."
    exit 1
fi
[ "$LINT_MODE" = yes ] && { echolog "Lint: OK — no block-closure problems found."; exit 0; }

[ $convRc == 1 ] && exit 0

# A+ : print the one-line summary (closes the last progress row). The full job
# table stays in the log; it only prints to stdout under -v.
echo "ssSummary" >> $run
echo "if [ \"\$ssV\" = verbose ]; then echo 'All submitted jobs: '; awk '{print substr(\$0, 1, 155)}' \$smartSlurmLogDir/allJobs.txt; echo ---------------------------------------------------------; else awk '{print substr(\$0, 1, 155)}' \$smartSlurmLogDir/allJobs.txt >> .smartSlurm.log; fi" >> $run

[[ "$RUN_MODE" == "dryrun" ]] && echo "[ \"\$ssV\" != quiet ] && echo Note: This is a dry run, so no job was actually submitted." >> $run

# A dry run previews the plan using the scope markers, but must not LEAVE them behind.
[[ "$RUN_MODE" == "dryrun" ]] && echo "rm -f \$smartSlurmLogDir/skipAllSuccessJobs*.txt \$smartSlurmLogDir/reRunAllSuccessJobs*.txt 2>/dev/null" >> $run


echo "early_exit=false" >> $run

echo "#cmd: $thisCmd" >> $run

[[ "$PIPELINE_SPEC" = *" "* ]] && para=${PIPELINE_SPEC#* } || para=""

[ "$VERBOSITY" != quiet ] && echolog ==========
[ "$VERBOSITY" != quiet ] && echolog Stage 2: Submitting jobs
#echo "echo $run $para is ready to run. Starting to run ..." >> $run

export ssV="$VERBOSITY"
eval "/bin/bash $run $para 2>&1" | tee -a .smartSlurm.log 

echolog  

RED='\033[0;31m'
NC='\033[0m' # No Color
GREEN='\033[0;32m'

if [ "$VERBOSITY" = verbose ]; then
  [[ "$RUN_MODE" == "dryrun" ]] && echolog -e "${GREEN}Dry run finished sumitting jobs.$NC" || echolog -e ${GREEN}runAsPipeline${NC} finished submitting jobs. 
  echolog Thank you for using Smart Slurm. You can run:
  echolog -e "${GREEN}less .smartSlurm.log${NC} to see detailed submission log."
  echolog -e "${GREEN}checkRun${NC} to check run status and submission logs"
  echolog -e "${RED}cancelAllJobs${NC} to cancel all jobs submitted from current directory."
elif [ "$VERBOSITY" != quiet ]; then
  [[ "$RUN_MODE" == "dryrun" ]] && echolog -e "${GREEN}Dry run finished.$NC  (cancelAllJobs to cancel, checkRun to monitor)" || echolog -e "${GREEN}runAsPipeline finished.$NC  cancelAllJobs to cancel  |  checkRun to monitor"
fi
