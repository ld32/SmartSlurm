function unExport() {
    # DEPRECATED: use 'smartslurm deactivate' instead.
    #
    # 'smartslurm deactivate' removes only SmartSlurm's own PATH entries (and the
    # prompt prefix), leaving anything you added afterward intact. The old
    # unExport instead stripped whatever directory held the current 'sbatch' --
    # which, when SmartSlurm was not actually aliasing sbatch, could remove the
    # *system* sbatch directory from PATH. This shim delegates when it can.
    echo "unExport is deprecated; use 'smartslurm deactivate'." >&2

    if type smartslurm >/dev/null 2>&1; then
        smartslurm deactivate
        return
    fi

    echo "unExport: the 'smartslurm' command is not loaded." >&2
    echo "  Run 'source \$SMARTSLURM_HOME/bin/smartslurm.sh' then 'smartslurm deactivate'," >&2
    echo "  or set up SmartSlurm with: bash \$SMARTSLURM_HOME/smartSlurmSetup.sh" >&2
    return 1
}
export unExport
