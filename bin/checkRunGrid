#!/bin/bash
# ===========================================================================
# checkRunGrid  --  PROTOTYPE grid view for checkRun (Module M3a).
#
# Renders run status as a sample x step grid when the jobs decompose cleanly
# into (sample, step); otherwise falls back to a linear, status-grouped list.
# Also resolves an alphanumeric grid address (e.g. b2, e3) to the underlying
# job log path(s). No live/arrow-key navigation -- static render + address prompt.
#
# Usage:
#   checkRunGrid [--log DIR] [--linear] [--no-color]      # render
#   checkRunGrid [--log DIR] <address>                     # resolve address->log(s)
#
# Status model (read from the log dir):
#   <flag>.success              -> done      (+ green)
#   <flag>.failed               -> error     (X red)   [? orange if "Unknown"]
#   started (.out, no terminal) -> running   (> yellow)
#   in allJobs, upstream errored -> orphaned (x red)
#   otherwise                   -> pending   (- grey)
# A cell backing >1 job renders as '@' (cyan), colored by aggregate status.
#
# Flag grammar (from rAP): step.depends.name[.sample[.fanout...]]
#   - no loop suffix          -> experiment-level step (spans all samples)
#   - first loop component     -> sample (outermost loop; user's convention)
#   - remaining components     -> intra-cell fan-out (e.g. per-chromosome)
# ===========================================================================
set -uo pipefail

LOGDIR="${smartSlurmLogDir:-smartSlurmLog}"
FORCE_LINEAR=""; ADDR=""; USE_COLOR="auto"; WHY=""; RESOLVE=""; RENDER=""; NO_HINT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --log) LOGDIR="$2"; shift 2;;
    --linear) FORCE_LINEAR=1; shift;;
    --no-color) USE_COLOR="off"; shift;;
    --no-hint) NO_HINT=1; shift;;
    --color) USE_COLOR="on"; shift;;
    why) WHY=1; shift;;
    # --resolve ADDR : print the flag(s) an address maps to, one per line, and
    #                  nothing else (non-zero exit on miss). The single source of
    #                  truth the interactive controller (checkRun) calls; it must
    #                  agree with what the render below numbers/letters.
    --resolve) RESOLVE=1; shift;;
    # --render : explicit alias for the default no-address render path, so callers
    #            name the mode instead of relying on "no arg = render".
    --render) RENDER=1; shift;;
    -h|--help) sed -n '2,20p' "$0"; exit 0;;
    *) ADDR="$1"; shift;;
  esac
done

[ -f "$LOGDIR/allJobs.txt" ] || { echo "no allJobs.txt in $LOGDIR" >&2; exit 1; }

# color setup
if [ "$USE_COLOR" = auto ]; then [ -t 1 ] && USE_COLOR=on || USE_COLOR=off; fi
if [ "$USE_COLOR" = on ]; then
  C_GREEN=$'\033[32m'; C_RED=$'\033[31m'; C_YEL=$'\033[33m'; C_GREY=$'\033[90m'
  C_ORANGE=$'\033[38;5;208m'; C_CYAN=$'\033[36m'; C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else C_GREEN=; C_RED=; C_YEL=; C_GREY=; C_ORANGE=; C_CYAN=; C_BOLD=; C_OFF=; fi

# ---- derive per-job fields in awk, then status in bash (clean globbing) ----
# awk emits: flag|step|name|sample|fan|dep
rawrows="$(
  awk '
    NR==1 { next }
    NF<3 { next }
    {
      flag=$3; dep=$2
      n=split(flag, f, ".")
      step=f[1]
      # The flag is  step . <dep> . <dep> ... . name . sample [. suffix]
      # with a VARIABLE number of numeric dependency fields between the step and
      # the name (a step can depend on several upstream steps). Skip that numeric
      # run to find the name, then take the sample as the next field. (The old
      # code assumed name=f[3], sample=f[4], which only held for single-dependency
      # steps and mis-read every multi-dependency step -> incoherent -> linear.)
      i=2; while (i<=n && f[i] ~ /^[0-9]+$/) i++
      name=(i<=n)?f[i]:""; i++
      sample=(i<=n)?f[i]:""
      fan=""; for(k=i+1;k<=n;k++) fan=fan (fan==""?"":".") f[k]
      printf "%s|%s|%s|%s|%s|%s\n", flag, step, name, sample, fan, dep
    }
  ' "$LOGDIR/allJobs.txt"
)"

# squeue snapshot (real cluster): "<id>-R"/"<id>-P" tokens. Empty in the harness.
# Cached (shared with checkRun's squeue_cache.txt, 120s TTL) so that repeated grid
# redraws during navigation don't each pay a live scheduler round-trip. An explicit
# refresh in checkRun rewrites the cache, so live data is one keypress away.
ACTIVE=""
_SQ_CACHE="squeue_cache.txt"; _SQ_TTL=120
if [ -f "$_SQ_CACHE" ] && [ "$(( $(date +%s) - $(stat -c %Y "$_SQ_CACHE" 2>/dev/null || echo 0) ))" -lt "$_SQ_TTL" ]; then
  ACTIVE="$(cat "$_SQ_CACHE" 2>/dev/null)"
elif command -v squeue >/dev/null 2>&1; then
  ACTIVE="$(squeue -u "${USER:-$(id -un)}" -t PD,R --noheader -o '%.18i-%t' 2>/dev/null)"
  printf '%s\n' "$ACTIVE" > "$_SQ_CACHE" 2>/dev/null
fi
# flag -> job_id map (last id wins, handles requeue)
declare -A ID_OF
if [ -f "$LOGDIR/allJobs.txt" ]; then
  while read -r id _dep flag _rest; do
    [ -n "$flag" ] && ID_OF["$flag"]="$id"
  done < <(awk 'NR>1 && NF>=3{print $1, $2, $3}' "$LOGDIR/allJobs.txt")
fi

# status codes: done error running pending unknown  (orphan resolved in a 2nd pass)
job_status() {   # $1=flag  -> echoes status
  local f="$1"
  if [ -e "$LOGDIR/$f.success" ]; then echo done; return; fi
  # plain .failed OR requeue-exhausted markers (.failed.requeued.N.mem/.time/.oomoot/.fail)
  if [ -e "$LOGDIR/$f.failed" ] || compgen -G "$LOGDIR/$f.failed.requeued.*" >/dev/null 2>&1; then
    if grep -qiE 'jobStatus: Unknown|Not sure why' "$LOGDIR/$f.out" 2>/dev/null; then echo unknown; else echo error; fi
    return
  fi
  # live scheduler truth, when available
  local id="${ID_OF[$f]:-}"
  if [ -n "$id" ] && [ -n "$ACTIVE" ]; then
    case "$ACTIVE" in
      *"$id-R"*) echo running; return;;
      *"$id-P"*) echo pending; return;;
    esac
  fi
  # fallback: a job that actually started writes body output (non-comment lines)
  # to .out; ssbatch pre-writes a #-comment preamble even for cancelled jobs, so
  # ".out exists" is NOT "it ran".
  if [ -e "$LOGDIR/$f.out" ] && grep -qE '^[^#[:space:]]' "$LOGDIR/$f.out" 2>/dev/null; then
    echo running; return
  fi
  echo pending
}

jobrows=""
declare -A ST_OF_FLAG
while IFS='|' read -r flag step name sample fan dep; do
  [ -z "$flag" ] && continue
  st="$(job_status "$flag")"
  ST_OF_FLAG["$flag"]="$st"
  jobrows+="$flag|$step|$name|$sample|$fan|$st|$dep"$'\n'
done <<<"$rawrows"
jobrows="${jobrows%$'\n'}"

# orphan pass: a pending job whose upstream dependency errored is orphaned (x).
# Reuse the statuses just computed (id -> flag -> status) instead of re-running
# job_status per job (which restats/greps every log a second time).
declare -A ST_BY_ID
while read -r id fl; do
  [ -n "$id" ] && ST_BY_ID["$id"]="${ST_OF_FLAG[$fl]:-}"
done < <(awk 'NR>1 && NF>=3 {print $1, $3}' "$LOGDIR/allJobs.txt")

neworows=""
while IFS='|' read -r flag step name sample fan st dep; do
  if [ "$st" = pending ] && [ -n "$dep" ] && [ "$dep" != null ]; then
    IFS=':' read -ra deps <<<"${dep#afterok:}"
    for d in "${deps[@]}"; do
      [[ "$d" =~ ^[0-9]+$ ]] || continue
      case "${ST_BY_ID[$d]:-}" in error|unknown|orphan) st=orphan;; esac
    done
  fi
  neworows+="$flag|$step|$name|$sample|$fan|$st|$dep"$'\n'
done <<<"$jobrows"
jobrows="${neworows%$'\n'}"

# ---- linear ordering: the ONE source of truth ------------------------------
# Both the linear render (render_linear) and the plain-integer address resolver
# derive their numbering from this exact sequence, so the number a user sees in
# the linear view always resolves to the same job.  Group order first, then
# jobrows order within a group.  Change the order in exactly one place: here.
# NB: 'orphan' MUST be here or orphaned jobs are invisible/unaddressable in the
# linear view (a latent bug in the original render_linear, which omitted it).
LINEAR_ORDER_GROUPS="error orphan unknown running pending done"
linear_flags() {   # emit flags in linear-view order, one per line (1-based)
  local grp
  for grp in $LINEAR_ORDER_GROUPS; do
    echo "$jobrows" | awk -F'|' -v g="$grp" '$6==g{print $1}'
  done
}

# _resolve_row ROWLETTERS STEP -> echo the per-sample flag(s) for that grid cell.
# ROWLETTERS is base-26 over the sorted sample list (a=1st sample, ...). Echoes
# nothing (and returns 1) if there is no such row.
_resolve_row() {
  local rowletters="${1,,}" step="$2" samples idx=0 i n c sample
  samples="$(echo "$jobrows" | awk -F'|' '$4!=""{print $4}' | sort -u -V 2>/dev/null)"
  n=${#rowletters}
  for ((i=0;i<n;i++)); do c="${rowletters:$i:1}"; idx=$(( idx*26 + ($(printf '%d' "'$c") - 96) )); done
  sample="$(echo "$samples" | sed -n "${idx}p")"
  [ -z "$sample" ] && return 1
  echo "$jobrows" | awk -F'|' -v s="$sample" -v st="$step" '$4==s && $2==st {print $1}'
}

# ---- address resolution mode ----
[ -n "$RESOLVE" ] && [ -z "$ADDR" ] && { echo "usage: checkRunGrid --resolve <address> --log DIR" >&2; exit 2; }
if [ -n "$ADDR" ]; then
  # collect the flag(s) this address maps to, then either print log paths or,
  # with `why`, run the M2 diagnosis engine on each.
  resolved=""
  # accept a reversed address (digit-then-letter) by canonicalising it to the
  # row-letter+step form. Safe now that verbs are always separate tokens, so a
  # single token can only be an address: '3a' -> 'a3', '4e' -> 'e4', '5aa' -> 'aa5'.
  if [[ "$ADDR" =~ ^([0-9]+)([a-zA-Z]+)$ ]]; then
    ADDR="${BASH_REMATCH[2]}${BASH_REMATCH[1]}"
  fi
  if [[ "$ADDR" =~ ^[0-9]+$ ]]; then
    # plain integer -> the Nth job in linear-view order. This is how non-grid
    # (linear) pipelines are addressed, and it stays valid in grid mode too.
    resolved="$(linear_flags | sed -n "${ADDR}p")"
  elif [[ "$ADDR" =~ ^[eE]([0-9]+)$ ]]; then
    step="${BASH_REMATCH[1]}"
    # experiment-level step N if such a step exists; a step is either experiment-
    # level or per-sample (never both), so this is unambiguous. Otherwise 'e' is
    # just row letter e (the 5th sample).
    resolved="$(echo "$jobrows" | awk -F'|' -v s="$step" '$4=="" && $2==s {print $1}')"
    [ -z "$resolved" ] && resolved="$(_resolve_row e "$step")"
  elif [[ "$ADDR" =~ ^([a-zA-Z]+)([0-9]+)$ ]]; then
    resolved="$(_resolve_row "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}")"
  else
    echo "unrecognized address: $ADDR (use e.g. b2 or e3)" >&2; exit 1
  fi
  [ -z "$resolved" ] && { echo "no job at $ADDR" >&2; exit 1; }
  cnt=$(echo "$resolved" | grep -c .)
  if [ -n "$RESOLVE" ]; then
    # machine mode: bare flags, one per line, nothing else. checkRun consumes
    # this and decides (single vs multi cell, then view/why/ai/raw on the flag).
    echo "$resolved"
    exit 0
  fi
  if [ -n "$WHY" ]; then
    # M2 diagnosis for each underlying job
    [ "$cnt" -gt 1 ] && echo "$ADDR backs $cnt jobs:"
    echo "$resolved" | while read -r fl; do
      if command -v diagnose.sh >/dev/null 2>&1; then diagnose.sh "$fl" --log "$LOGDIR"
      else "$(dirname "$0")/diagnose.sh" "$fl" --log "$LOGDIR"; fi
    done
  else
    [ "$cnt" -gt 1 ] && echo "$ADDR is a multi-job cell ($cnt jobs):"
    echo "$resolved" | while read -r fl; do echo "  $LOGDIR/$fl.out"; done
  fi
  exit 0
fi

# ---- decide grid vs linear ----
# clean grid requires: at least one per-sample step, and no step that is BOTH
# per-sample and experiment-level, and later per-sample steps' sample sets must
# overlap the first per-sample step's samples (else axes differ -> ragged).
read -r CLEAN SAMPLES_CSV STEPS_CSV EXP_CSV <<<"$(
  echo "$jobrows" | awk -F'|' '
    { step=$2; name=$3; sample=$4
      stepname[step]=name
      if (sample=="") expstep[step]=1
      else { persample[step]=1; samp[sample]=1; stepsamp[step","sample]=1 }
      steps[step]=1
    }
    END{
      # ambiguous step?
      amb=0; for(s in persample) if(s in expstep) amb=1
      # ordered steps
      ns=0; for(s in steps) ord[ns++]=s
      # sort steps numerically
      for(i=0;i<ns;i++)for(j=i+1;j<ns;j++)if(ord[i]+0>ord[j]+0){t=ord[i];ord[i]=ord[j];ord[j]=t}
      # sample list (numeric sort if possible)
      nsamp=0; for(x in samp) sl[nsamp++]=x
      for(i=0;i<nsamp;i++)for(j=i+1;j<nsamp;j++)if(sl[i]+0>sl[j]+0){t=sl[i];sl[i]=sl[j];sl[j]=t}
      # first per-sample step
      firstps=""; for(i=0;i<ns;i++){ if(ord[i] in persample){firstps=ord[i];break} }
      # coherence: every per-sample step shares >=1 sample with firstps
      coherent=1
      for(i=0;i<ns;i++){ s=ord[i]; if(!(s in persample))continue; ov=0;
        for(k=0;k<nsamp;k++){ if((firstps","sl[k]) in stepsamp && (s","sl[k]) in stepsamp) ov=1 }
        if(!ov) coherent=0
      }
      clean=(amb==0 && coherent==1 && firstps!="" && nsamp>0) ? 1 : 0
      # build CSVs
      sc=""; for(k=0;k<nsamp;k++) sc=sc (sc==""?"":",") sl[k]
      pc=""; for(i=0;i<ns;i++){ if(ord[i] in persample) pc=pc (pc==""?"":",") ord[i]":"stepname[ord[i]] }
      ec=""; for(i=0;i<ns;i++){ if(ord[i] in expstep)   ec=ec (ec==""?"":",") ord[i]":"stepname[ord[i]] }
      print clean, (sc==""?"-":sc), (pc==""?"-":pc), (ec==""?"-":ec)
    }'
)"

# status glyph+color for a single status code
glyph() { case "$1" in
  done) printf '%s' "${C_GREEN}+${C_OFF}";;
  error) printf '%s' "${C_RED}X${C_OFF}";;
  orphan) printf '%s' "${C_RED}x${C_OFF}";;
  running) printf '%s' "${C_YEL}${C_BOLD}>${C_OFF}";;
  unknown) printf '%s' "${C_ORANGE}?${C_OFF}";;
  pending) printf '%s' "${C_GREY}-${C_OFF}";;
  multi) printf '%s' "${C_CYAN}@${C_OFF}";;   # colored below by aggregate
esac; }

# aggregate status for a cell's job list (worst wins): error>unknown>running>pending>done
agg() { local a="$1"; case "$a" in
  *error*) echo error;; *unknown*) echo unknown;; *running*) echo running;;
  *pending*) echo pending;; *) echo done;; esac; }

# repeat a (possibly multibyte) char N times
_repeat() { local n="$1" c="$2" s=""; while [ "$n" -gt 0 ]; do s="$s$c"; n=$((n-1)); done; printf '%s' "$s"; }
# center plain (escape-free) text within a field of visible width $2
_center() {
  local t="$1" w="$2" len l r
  len=${#t}; [ "$len" -ge "$w" ] && { printf '%s' "${t:0:$w}"; return; }
  l=$(( (w-len)/2 )); r=$(( w-len-l ))
  printf '%*s%s%*s' "$l" '' "$t" "$r" ''
}

# draw a single-line box (all four sides) with TITLE embedded in the top edge.
# Each remaining arg is "VISLEN<TAB>TEXT": VISLEN is the visible width of TEXT
# (TEXT may contain color escapes, which have zero visible width), so the box
# stays aligned while the content keeps its colors. Falls back to unboxed lines
# if it would exceed the terminal width.
_legend_box() {
  local title="$1"; shift
  local termw w=0 fill entry vis txt pad
  termw="${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}"; [ "$termw" -gt 100 ] && termw=100
  for entry in "$@"; do vis="${entry%%$'\t'*}"; [ "$vis" -gt "$w" ] && w="$vis"; done
  if [ $((w + 4)) -gt "$termw" ]; then
    for entry in "$@"; do printf '%s\n' "${entry#*$'\t'}"; done; return
  fi
  local titlestr="─ ${title} "
  fill=$(( (w + 2) - ${#titlestr} )); [ "$fill" -lt 0 ] && fill=0
  printf '┌%s%s┐\n' "$titlestr" "$(_repeat "$fill" '─')"
  for entry in "$@"; do
    vis="${entry%%$'\t'*}"; txt="${entry#*$'\t'}"; pad=$(( w - vis ))
    printf '│ %s%*s │\n' "$txt" "$pad" ''
  done
  printf '└%s┘\n' "$(_repeat $((w + 2)) '─')"
}

# counts for the summary line
summary="$(echo "$jobrows" | awk -F'|' '{c[$6]++} END{
  printf "%d %d %d %d %d %d", c["done"], c["error"]+0, c["running"]+0, c["pending"]+0, c["unknown"]+0, c["orphan"]+0 }')"
read -r n_done n_err n_run n_pend n_unk n_orph <<<"$summary"
total=$(echo "$jobrows" | grep -c .)
runname="$(basename "$(cd "$LOGDIR/.." && pwd)")"

print_header() {
  printf '%sFound %d jobs%s\n\n' "$C_BOLD" "$total" "$C_OFF"
  printf 'Status:  %s %d done   %s %d error   %s %d running   %s %d pending' \
    "${C_GREEN}✓${C_OFF}" "$n_done" "${C_RED}✗${C_OFF}" "$n_err" "${C_YEL}▸${C_OFF}" "$n_run" "${C_GREY}·${C_OFF}" "$n_pend"
  [ "$n_unk"  -gt 0 ] && printf '   %s %d unknown' "${C_ORANGE}?${C_OFF}" "$n_unk"
  [ "$n_orph" -gt 0 ] && printf '   %s %d orphaned' "${C_RED}x${C_OFF}" "$n_orph"
  echo
}

print_legend() {
  echo
  printf 'Legend:  %s done  %s error  %s orphaned  %s running  %s pending  %s unknown  %s multi-job\n' \
    "${C_GREEN}+${C_OFF}" "${C_RED}X${C_OFF}" "${C_RED}x${C_OFF}" "${C_YEL}>${C_OFF}" "${C_GREY}-${C_OFF}" "${C_ORANGE}?${C_OFF}" "${C_CYAN}@${C_OFF}"
}

# ================= LINEAR fallback =================
render_linear() {
  print_header
  echo
  echo "$jobrows" | awk -F'|' -v G="1" '
    BEGIN{
      # nothing
    }
    { rows[NR]=$0 }
    END{
      # group by status, ordered error,unknown,running,pending,done
      order[1]="error";order[2]="unknown";order[3]="running";order[4]="pending";order[5]="done"
    }' >/dev/null
  # simple: print a numbered list grouped by status.
  # Iterate the SAME group order (and the same per-group awk) as linear_flags(),
  # so the number printed here is exactly what `--resolve <N>` returns.
  local i=0
  for grp in $LINEAR_ORDER_GROUPS; do
    local block
    block="$(echo "$jobrows" | awk -F'|' -v g="$grp" '$6==g{print $1}')"
    [ -z "$block" ] && continue
    case "$grp" in
      error) lbl="${C_RED}errors${C_OFF}";; orphan) lbl="${C_RED}orphaned${C_OFF}";;
      unknown) lbl="${C_ORANGE}unknown${C_OFF}";;
      running) lbl="${C_YEL}running${C_OFF}";; pending) lbl="${C_GREY}pending${C_OFF}";;
      done) lbl="${C_GREEN}done${C_OFF}";; esac
    printf '\n%s:\n' "$lbl"
    while read -r fl; do i=$((i+1)); printf '  %3d  %s   %s\n' "$i" "$(glyph "$grp")" "$fl"; done <<<"$block"
  done
  print_legend
  echo
  echo "This run does not flatten to a clean sample x step grid; showing linear view."
  if [ -z "$NO_HINT" ]; then echo "Type a job number to view its log."; fi
}

# ================= GRID =================
render_grid() {
  print_header
  # order samples deterministically (sort -V: lexical for names, numeric for
  # ids) so the row letters here match the address resolver above.
  mapfile -t SAMPLES < <(echo "$SAMPLES_CSV" | tr ',' '\n' | sort -u -V)
  IFS=',' read -ra PSTEPS  <<<"$STEPS_CSV"
  IFS=',' read -ra ESTEPS  <<<"$EXP_CSV"

  # Sample names are often long, near-identical paths. Strip their longest common
  # prefix so row labels differ; the full names are listed in a legend below.
  local SLCP="${SAMPLES[0]}" _s
  for _s in "${SAMPLES[@]}"; do
    while [ -n "$SLCP" ] && [ "${_s#"$SLCP"}" = "$_s" ]; do SLCP="${SLCP%?}"; done
  done

  local COLW=7 pad="   "
  # collect the visible per-sample step columns
  local -a SNUM SNAME; local ps
  for ps in "${PSTEPS[@]}"; do
    [ "$ps" = "-" ] && continue
    SNUM+=("${ps%%:*}"); SNAME+=("${ps#*:}")
  done
  local n=${#SNUM[@]} i

  # label area (row letter + sample) is printed to the LEFT of the framed grid;
  # LEAD is that same width in blanks, used to indent the frame borders.
  local LEAD; LEAD="${pad}$(printf '%-4s %-11s' '' '')"

  # box-border pieces (top / bottom), one segment per step column
  local dash; dash="$(_repeat "$COLW" '─')"
  local top="┌" bot="└"
  for ((i=0;i<n;i++)); do
    if [ $i -lt $((n-1)) ]; then top="$top$dash┬"; bot="$bot$dash┴"
    else top="$top$dash┐"; bot="$bot$dash┘"; fi
  done

  # --- header: step NAMES on one row, step NUMBERS on the row nearest the cells
  printf '\n%s%-4s %-11s' "$pad" "row" "sample"
  for ((i=0;i<n;i++)); do printf ' %s%s%s' "$C_BOLD" "$(_center "${SNAME[$i]:0:$COLW}" "$COLW")" "$C_OFF"; done
  echo
  printf '%s%-4s %-11s' "$pad" '' ''
  for ((i=0;i<n;i++)); do printf ' %s%s%s' "$C_BOLD" "$(_center "${SNUM[$i]}" "$COLW")" "$C_OFF"; done
  echo
  printf '%s%s\n' "$LEAD" "$top"      # top edge of the grid, right under the numbers

  # --- data rows (framed) ---
  local r=0 s c glyph_l glyph_r
  glyph_l=$(( (COLW-1)/2 )); glyph_r=$(( COLW-1-glyph_l ))
  for s in "${SAMPLES[@]}"; do
    [ "$s" = "-" ] && continue
    local rl; rl="$(printf "\\$(printf '%03o' $((97+r)))")"   # a,b,c...
    local slabel="${s#"$SLCP"}"
    printf '%s%-4s %-11s│' "$pad" "$rl" "${slabel:0:11}"
    for ((c=0;c<n;c++)); do
      local num="${SNUM[$c]}"
      local jobs; jobs="$(echo "$jobrows" | awk -F'|' -v s="$s" -v st="$num" '$4==s && $2==st{print $6}')"
      local cnt; cnt="$(echo -n "$jobs" | grep -c . 2>/dev/null)"; [ -z "$cnt" ] && cnt=0
      local cell
      if [ "$cnt" -eq 0 ]; then cell="${C_GREY}·${C_OFF}"      # blank: sample skips this step
      elif [ "$cnt" -eq 1 ]; then cell="$(glyph "$jobs")"
      else
        # multi-job cell: '@' colored by aggregate status
        local a; a="$(agg "$(echo "$jobs" | tr '\n' ' ')")"
        local col_
        case "$a" in error) col_="$C_RED";; unknown) col_="$C_ORANGE";; running) col_="$C_YEL";; pending) col_="$C_GREY";; *) col_="$C_GREEN";; esac
        cell="${col_}@${C_OFF}"
      fi
      printf '%*s%b%*s│' "$glyph_l" '' "$cell" "$glyph_r" ''
    done
    echo
    r=$((r+1))
  done
  printf '%s%s\n' "$LEAD" "$bot"       # bottom edge of the grid

  # row -> sample key. Only worth printing when the labels don't fully identify
  # the sample (a common prefix was stripped, or a name is longer than the label).
  local _needkey="" _rr=0 _sx
  if [ -n "$SLCP" ]; then _needkey=1; else
    for _sx in "${SAMPLES[@]}"; do [ "${#_sx}" -gt 11 ] && { _needkey=1; break; }; done
  fi
  if [ -n "$_needkey" ]; then
    printf '\n%ssamples:%s' "$C_BOLD" "$C_OFF"
    [ -n "$SLCP" ] && printf '  %s(common prefix %s… omitted)%s' "$C_GREY" "$SLCP" "$C_OFF"
    echo
    for _sx in "${SAMPLES[@]}"; do
      [ "$_sx" = "-" ] && continue
      local _rl; _rl="$(printf "\\$(printf '%03o' $((97+_rr)))")"
      printf '%s%s%s%s  %s\n' "$pad" "$C_BOLD" "$_rl" "$C_OFF" "${_sx#"$SLCP"}"
      _rr=$((_rr+1))
    done
  fi

  # experiment-level steps
  if [ "${ESTEPS[0]}" != "-" ]; then
    printf '\n%sexperiment-level (across all samples):%s\n' "$C_BOLD" "$C_OFF"
    for es in "${ESTEPS[@]}"; do
      local num="${es%%:*}" nm="${es#*:}"
      local st; st="$(echo "$jobrows" | awk -F'|' -v st="$num" '$4=="" && $2==st{print $6}' | head -1)"
      [ -z "$st" ] && st="pending"
      printf '%sE%-3s %-10s %b   [step %s]\n' "$pad" "$num" "$nm" "$(glyph "$st")" "$num"
    done
  fi

  # legend, boxed on all four sides. Build a PLAIN copy (for the visible width)
  # and a COLORED copy (glyphs tinted like the grid) of each line.
  local _statusplain="status : + done  X error  x orphaned  > running  - pending  ? unknown  @ multi-job"
  local _statuscolor="status : ${C_GREEN}+${C_OFF} done  ${C_RED}X${C_OFF} error  ${C_RED}x${C_OFF} orphaned  ${C_YEL}${C_BOLD}>${C_OFF} running  ${C_GREY}-${C_OFF} pending  ${C_ORANGE}?${C_OFF} unknown  ${C_CYAN}@${C_OFF} multi-job"
  local _stepsplain="steps  : "
  for ps in "${PSTEPS[@]}"; do [ "$ps" = "-" ] || _stepsplain="$_stepsplain${ps%%:*}=${ps#*:}  "; done
  for es in "${ESTEPS[@]}"; do [ "$es" = "-" ] || _stepsplain="$_stepsplain${es%%:*}=${es#*:}  "; done
  echo
  _legend_box "legend" \
      "${#_statusplain}"$'\t'"$_statuscolor" \
      "${#_stepsplain}"$'\t'"$_stepsplain"
  if [ -z "$NO_HINT" ]; then
    echo
    echo "Type an address like ${C_BOLD}b2${C_OFF} (row+step) or ${C_BOLD}E3${C_OFF} (experiment step) to view its log."
    echo "'@' cells back multiple jobs; the address lists them."
  fi
}

if [ -n "$FORCE_LINEAR" ] || [ "$CLEAN" != 1 ]; then render_linear; else render_grid; fi
exit 0   # a successful render always exits 0 (never let a trailing command leak a non-zero code)
