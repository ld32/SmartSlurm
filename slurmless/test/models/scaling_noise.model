# Same linear truth as scaling_linear, but with ~8% gaussian noise on mem and
# ~8% on time, to test that the fit still recovers the trend (slope within band).
MODEL_PROGRAM=scaleLin
MODEL_REF=none
MEM_FORM=linear
MEM_A=0.5
MEM_B=200
TIME_FORM=linear
TIME_A=0.02
TIME_B=10
MAXRSS_FACTOR=0.9
NOISE_MEM=0.08
NOISE_TIME=0.08
SEED=42
