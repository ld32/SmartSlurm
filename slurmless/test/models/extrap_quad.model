# Super-linear (quadratic) truth, used to study EXTRAPOLATION failure: train on
# small sizes (100..1000) where it looks nearly linear, then predict at 10x..50x
# where a STRAIGHT-line fit under-provisions badly. mem = 0.0005*size^2 + 0.3*size
# + 200 (M); time grows mildly linear.
MODEL_PROGRAM=extraQuad
MODEL_REF=none
MEM_FORM=poly
MEM_A=0.0005
MEM_B=0.3
MEM_C=200
TIME_FORM=linear
TIME_A=0.02
TIME_B=10
MAXRSS_FACTOR=1.0
NOISE_MEM=0.05
NOISE_TIME=0.05
SEED=42
